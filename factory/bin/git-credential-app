#!/bin/sh
# git credential helper for the factory's GitHub App token.
# git runs it as "git-credential-app get"; it answers with the installation token
# that factory/bin/job puts in FACTORY_GIT_TOKEN for its own fetches and pushes
# only. Anything else (store, erase, or no token set) gets no answer.
[ "$1" = get ] || exit 0
[ -n "${FACTORY_GIT_TOKEN:-}" ] || exit 0
printf 'username=x-access-token\npassword=%s\n' "$FACTORY_GIT_TOKEN"
